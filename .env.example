# SnapEdit Studio 配置
# 后端：cloud（官方云端，默认，零本地模型）/ local（本地CPU兜底）
SNAPEDIT_BACKEND=cloud
# 官方 API 地址（一般不用改）
SNAPEDIT_API_BASE=https://be-prod-1.snapedit.app
# 端口
PORT=8000

# ===== 认证（必须配置，别用默认值上生产）=====
# WebUI 管理员密码（访问页面需要）
ADMIN_PASSWORD=SnapEdit@2026
# API Bearer Token，逗号分隔可配多个（OpenAI 兼容客户端用）
API_TOKENS=snapedit-demo-token-2026
# 会话签名密钥（32+ 随机字符；不设则每次启动随机，重启后 WebUI 会话失效）
SESSION_SECRET=
# 会话有效期（秒，默认 7 天）
SESSION_TTL=604800
